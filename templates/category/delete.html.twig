{% extends 'base.html.twig'%}

{% block body %}

<h1>Delete Category</h1>

{% if category.products|length == 0 %}
<p>Are you sure you want to delete this category?</p>

{% else %}
<p>Are you sure you want to delete category? This will move the products to the Uncategorized category</p>
    
{% endif %}


<form method="post">

    <button>Yes</button>

    <a href="{{ path('category_show', {'id': category.id})}}">No</a>

</form>

{% endblock %}