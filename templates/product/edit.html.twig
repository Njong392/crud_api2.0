{% extends 'base.html.twig'%}

{% block body %}

	<h1>Edit Product</h1>

	{% if product.imageFilename %}
		<img src="{{ asset('uploads/images/' ~ filename) }}" alt="{{ product.name }}" style="max-width: 500px; max-height: 500px;">
	{% endif %}

	{{ include('product/_form.html.twig') }}

	<a href="{{ path('product_show', {'id': product.id})}}">Cancel</a>

{% endblock %}
